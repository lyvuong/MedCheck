# Copy to .env for local dev. These are also the exact values to set as
# Cloudflare Pages build environment variables. Not secret — this is
# Firebase's public web config, not a credential (access is controlled
# by firestore.rules, not by hiding these values). Get them by running,
# from the repo root:
#   firebase apps:sdkconfig WEB <appId> --project <your-project-id>

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
