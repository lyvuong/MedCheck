rules_version = '2';

// Only the backend (Firebase Admin SDK, running server-side with a
// service-account credential) ever touches Firestore — the frontend
// always goes through the Fastify REST API, never directly to Firestore.
// The Admin SDK bypasses these rules entirely, so denying all client
// access here just closes off any accidental/future direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
