# Copy to .env and fill in for local dev. In docker-compose these are set
# via the compose file / top-level .env instead.

FIRESTORE_PROJECT_ID="your-firebase-project-id"
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Creates the first admin account automatically on first boot if no users
# exist yet. Change the password after logging in (or just use the seed
# script's sample accounts in dev).
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me"

# Weno Exchange live formulary lookup (optional). Leave unset to disable —
# the app works fine on manual/CMS-imported data alone. Sign up at
# https://wenoexchange.com to get credentials.
WENO_API_BASE_URL=
WENO_API_KEY=
