# Copy to .env before running `docker compose up`.

POSTGRES_USER=medcheck
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=medcheck

# Long random string — used to sign login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Port the web UI is published on (http://<your-server-ip>:WEB_PORT).
WEB_PORT=8080

# If the frontend is served from a different origin than this (e.g. you
# put it behind a reverse proxy on its own domain), set that origin here
# instead of "*".
CORS_ORIGIN=*

# Creates the first admin account automatically on first boot, if no
# users exist yet. Log in with these, then create real accounts for your
# doctors/staff from the Admin screen and consider disabling this account.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# Optional: Weno Exchange live formulary lookup. Leave blank to disable —
# the app works fine on manual/CMS-imported data alone. Sign up at
# https://wenoexchange.com to get credentials, then fill these in and
# restart the backend.
WENO_API_BASE_URL=
WENO_API_KEY=
